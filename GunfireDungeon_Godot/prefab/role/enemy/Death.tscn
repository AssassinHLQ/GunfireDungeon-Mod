; 死神: 帧画布 186x123, "脚下中心" 在 (93, 122)。
; offset = -(122 - 123/2) = -60.5, 让脚下中心落在节点原点上。
; 受击框 56x100 对准身体(比普通敌人高得多)。
; DeathEnemy.OnInit 里会按同样的数值再设一次(取自 DeathSpriteFrames.SpriteOffset),
; 这里写上是为了在编辑器里能直接看到。
[sub_resource type="RectangleShape2D" id="RectangleShape2D_boss"]
size = Vector2(56, 100)

