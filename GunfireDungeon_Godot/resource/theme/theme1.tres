SettingButton/styles/hover = SubResource("BtnHoverSet")
SettingButton/styles/pressed = SubResource("BtnHoverSet")
SettingButton/styles/focus = SubResource("BtnFocusSet")
SettingButton/styles/disabled = SubResource("BtnNormalSet")

; CheckBox 继承 Button 的样式链, 不显式覆盖就会被 96px 花边边框撑爆。
; 这里把背景样式全部置空(只显示图标), 并用自制的正方形像素图标替换引擎默认图标。
; 关键: Godot 的 CheckBox 图标边长 = 其 font_size。若沿用 Button 的 32,
; 图标只有 16px 就会显成长方形。所以必须显式给 CheckBox 设自己的字号。
CheckBox/font_sizes/font_size = 24
CheckBox/styles/normal = SubResource("CbEmpty")
CheckBox/styles/hover = SubResource("CbEmpty")
CheckBox/styles/pressed = SubResource("CbEmpty")
CheckBox/styles/focus = SubResource("CbEmpty")
CheckBox/styles/disabled = SubResource("CbEmpty")
CheckBox/icons/checked = ExtResource("7_cbon")
CheckBox/icons/unchecked = ExtResource("6_cboff")
CheckBox/icons/checked_disabled = ExtResource("7_cbon")
CheckBox/icons/unchecked_disabled = ExtResource("6_cboff")

