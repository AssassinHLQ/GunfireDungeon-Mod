PauseButton/styles/hover = SubResource("BtnHoverPause")
PauseButton/styles/pressed = SubResource("BtnHoverPause")
PauseButton/styles/focus = SubResource("BtnFocusPause")
PauseButton/styles/disabled = SubResource("BtnNormalPause")
